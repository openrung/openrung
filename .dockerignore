# Keep the Docker build context small and free of non-Go assets / secrets.
# Server images need go.mod/go.sum, cmd/, internal/, the nested Go modules,
# and their component-specific deploy assets.

.git
.gitignore
.github
.DS_Store
**/.DS_Store

# Docs are not needed to build the relay.
*.md
# ...but the third-party notices must ship inside the image (license compliance).
!THIRD_PARTY_NOTICES.md
docs

# The desktop apps are separate Go modules the server images never build;
# keep them (and any locally installed frontend deps) out of the context.
desktop
desktop-volunteer
**/node_modules

# Build outputs / caches.
bin
dist
build
.build
.gocache
.cache
.claude

# Local runtime files and secrets. The Dockerfiles do not consume environment
# templates, so keep examples out of the broad `COPY . .` build stages too.
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
**/*.env
**/*.env.*

# Locally generated private-key material. Public .crt certificates may remain
# available to builds, but private keys must never enter a COPY . . layer.
*.key
*.pem
*.p12
*.pfx
*.seed
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.seed
*.local.json
openrung-telemetry.jsonl
openrung-xray-config.json
