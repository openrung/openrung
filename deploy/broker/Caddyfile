# OpenRung broker origin-TLS front.
#
# Terminates Let's Encrypt TLS on :443 for broker-origin.openrung.org and
# reverse-proxies to the broker container on 127.0.0.1:8080. Auto-renewal is
# native to Caddy (the running service renews ~30 days before expiry). Both CDN
# fronts use this leg: the AWS CloudFront distribution and the Cloudflare Worker
# (broker.openrung.org). The plaintext :8080 origin stays open for volunteer-run
# relay registration.
#
# Serves its cert on SNI broker-origin.openrung.org. CloudFront (distribution
# E2PLKW8FO3JZSA) is configured to send THAT hostname as the origin SNI via the
# AllViewerExceptHostHeader origin-request policy. (Do NOT switch it back to
# AllViewer: that forwards the viewer Host, which CloudFront then uses as the
# origin SNI — the distribution domain, which this proxy has no cert for, so the
# handshake 502s. See origin-tls.md.) The default ECDSA (P-256) leaf is fine for
# CloudFront and every other client.
#
# OPENRUNG_WORKER_ORIGIN_AUTH must be in Caddy's environment (see origin-tls.md);
# it is the same value as the Worker's ORIGIN_AUTH secret.
{
	# No ACME account email on purpose: Caddy auto-renews, so expiry notices are
	# non-essential, and we avoid tying an operator identity to the issuance.
	# Let's Encrypt production CA + ToS are accepted implicitly by Caddy.
}

broker-origin.openrung.org {
	# Client-IP provenance.
	#
	# The broker honors forwarded client IPs only from trusted proxies
	# (internal/broker/clientip.go) and trusts this loopback hop:
	# OPENRUNG_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128 IS set on the broker.
	# So Caddy decides which X-Forwarded-For value the broker sees:
	#   - our Cloudflare Worker (a Cloudflare source address AND the shared
	#     origin-auth secret): the Worker-supplied X-Forwarded-For;
	#   - everything else (CloudFront edges, direct hits): our own immediate
	#     peer, e.g. the UNSPOOFABLE CloudFront edge IP.
	# The size() guard fails closed if the secret is unset or short.
	@cloudflare_worker {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/).
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		expression `size("{$OPENRUNG_WORKER_ORIGIN_AUTH}") >= 32 && {http.request.header.X-OpenRung-Origin-Auth} == "{$OPENRUNG_WORKER_ORIGIN_AUTH}"`
	}

	handle @cloudflare_worker {
		reverse_proxy 127.0.0.1:8080 {
			header_up -CF-Connecting-IP
			header_up -X-OpenRung-Origin-Auth
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up -CF-Connecting-IP
			header_up -X-OpenRung-Origin-Auth
			header_up X-Forwarded-For {remote_host}
		}
	}

	log {
		output file /var/log/caddy/broker-origin.access.log {
			roll_size 20MiB
			roll_keep 5
		}
		# Caddy redacts only its built-in credential headers; the origin-auth
		# secret must be deleted explicitly (Go canonicalizes the header name).
		format filter {
			request>headers>X-Openrung-Origin-Auth delete
		}
	}
}
