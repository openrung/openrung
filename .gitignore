.DS_Store
.cache/
.gocache/
.build/
__pycache__/
*.py[cod]

# Local multi-module workspaces (dev-only; module wiring is via replace directives)
go.work
go.work.sum

# Local agent guidance
/AGENTS.md

# Build outputs
/bin/
/dist/

# Local generated relay configs
openrung-xray-config.json

# Internal ops tooling — reveals hosting providers/fleet layout; keep out of the public repo
/scripts/relay-usage.sh

# WSS front state written by OPENRUNG_WSS_FRONT_STATE_FILE.  Front hostnames are
# rotated when they are blocked, so committing a mapping would preserve every
# one this project has ever used, permanently, in git history.  Derive the live
# mapping with `deploy/relay/bunny/bunny-wss-front.sh inventory` instead.
wss-fronts.json
*-wss-front-state.json
*.local.json

# Runtime-generated broker telemetry log
openrung-telemetry.jsonl

# Environment files
.env
.env.*
!.env.example
/deploy/relay/.wss.env

# Wrangler local state (R2/Workers tooling)
.wrangler/

# Claude Code local worktrees (may contain absolute paths / local branch content)
.claude/agents/
.claude/worktrees/
/relay
/broker
/openrung-*
